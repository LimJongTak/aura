rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 신청서에 적힌 studentId 본인이 로그인한 상태에서 쓰는 요청인지 확인한다
    // (Firebase Auth 이메일이 항상 {학번}@s.scnu.ac.kr 형태이므로 문자열로
    // 대조할 수 있다). 이름+학번만으로 아무나 쓸 수 있던 예전 모델을 대체한다.
    function isSelf(studentId) {
      return isSignedIn() && request.auth.token.email == (studentId + "@s.scnu.ac.kr");
    }

    // 현재 학기 및 마일리지 신청 기간의 단일 진실 공급원. semesters 컬렉션에서
    // 관리자가 "현재 학기"로 지정할 때마다 이 문서도 함께 갱신된다 — 마일리지
    // 신청 마감을 클라이언트가 보낸 값이 아니라 항상 서버에 저장된 이 값으로
    // 검증하기 위함.
    function currentSemester() {
      return get(/databases/$(database)/documents/semesterState/current).data;
    }

    // 관리자 여부를 클라이언트가 확인할 수 있도록 본인 문서만 읽기 허용.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // 학생명단: 이름+학번 본인확인(단건 조회, get)은 로그인 없이 가능해야
    // 하지만, 컬렉션 전체를 훑는 목록 조회(list)까지 열어두면 전화번호를
    // 포함한 전체 명단이 그대로 유출된다 — list는 관리자만 허용한다.
    match /students/{studentId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 활동기준 / 이수과목마스터 / 환산설정: 신청 폼에 필요한 공개 참조
    // 데이터(개인정보 아님) — 목록 조회까지 공개해도 안전하다.
    match /activityStandards/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /subjectMaster/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /conversionSettings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 중고급이수자명단: 이름+지급액 등 개인정보 성격이 있어 관리자만 조회.
    match /advancedRecipients/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 우측 플로팅 퀵메뉴: 공개 읽기, 관리자만 쓰기.
    match /quickLinks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 비밀번호 변경 인증번호: Cloud Functions(Admin SDK)만 접근한다.
    match /passwordResets/{id} {
      allow read, write: if false;
    }

    // 학기 목록(학기별 관리·필터용)과 "현재 학기" 상태 — 둘 다 공개 읽기,
    // 관리자만 쓰기.
    match /semesters/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /semesterState/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 방문자 통계: 누구나 오늘 카운트를 정확히 1씩만 늘릴 수 있고, 그 외
    // 필드는 손댈 수 없다. 집계된 히스토리 조회는 관리자만 가능.
    match /visitStats/{date} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.count == 1
                    && request.resource.data.keys().hasOnly(["count", "updatedAt"]);
      allow update: if request.resource.data.count == resource.data.count + 1
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["count", "updatedAt"]);
      allow delete: if false;
    }

    // 마일리지 신청: 학번@s.scnu.ac.kr 계정으로 로그인한 본인만 자신의 신청을
    // 생성할 수 있다. 상태 변경은 관리자만 가능하다. mileage는 점수표
    // 최댓값(50점)을 넘지 못하도록 서버 측에서도 한 번 더 막아, 클라이언트를
    // 우회한 임의 값 주입을 막는다.
    match /mileageApplications/{id} {
      allow read: if true;

      allow create: if
        (
          (
            isSelf(request.resource.data.studentId) &&
            request.resource.data.status == "검토중" &&
            request.resource.data.source == "self" &&
            request.resource.data.mileage <= 50 &&
            // 관리자가 설정한 현재 학기의 마일리지 신청 기간 내에만 접수한다.
            request.resource.data.semester == currentSemester().semesterName &&
            request.time >= currentSemester().mileageApplyStart &&
            request.time <= currentSemester().mileageApplyEnd
          ) ||
          (
            // 관리자가 심사 없이 직접 지급하는 마일리지 — 신청 기간 제약을 받지 않고
            // 바로 승인 상태로 생성된다.
            isAdmin() &&
            request.resource.data.status == "승인" &&
            request.resource.data.source == "bulk"
          )
        ) &&
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string &&
        request.resource.data.category is string &&
        request.resource.data.activityName is string &&
        request.resource.data.mileage is number &&
        request.resource.data.mileage > 0 &&
        exists(/databases/$(database)/documents/students/$(request.resource.data.studentId));

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "note", "processedAt", "semester", "paid", "paidAt", "recalled", "recalledAt", "recallReason"]);

      allow delete: if isAdmin();
    }

    // 중고급 이수 신청: 위와 동일한 모델.
    match /advancedApplications/{id} {
      allow read: if true;

      allow create: if
        isSelf(request.resource.data.studentId) &&
        request.resource.data.status == "검토중" &&
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string &&
        request.resource.data.department is string &&
        request.resource.data.targetSemester is string &&
        request.resource.data.level in ["중급", "고급"] &&
        request.resource.data.subjects is list &&
        request.resource.data.subjects.size() == 2 &&
        request.resource.data.immersive is map &&
        request.resource.data.nonCurricularProgram is string &&
        request.resource.data.nonCurricularYearMonth is string &&
        request.resource.data.transcriptFileUrl is string &&
        request.resource.data.transcriptFileUrl.size() > 0 &&
        exists(/databases/$(database)/documents/students/$(request.resource.data.studentId));

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "note", "processedAt"]);

      allow delete: if isAdmin();
    }

    // 학생 등록 신청: 학생명단에 없는 학생이 이름·학번·학과를 제출하면
    // 관리자 승인 후 students 문서가 생성된다. 이미 등록된 학번은 신청 불가.
    // 승인 전 목록은 개인정보라 관리자만 조회 가능.
    match /studentRegistrationRequests/{id} {
      allow get, list: if isAdmin();

      allow create: if
        request.resource.data.status == "검토중" &&
        request.resource.data.studentId is string &&
        request.resource.data.name is string &&
        request.resource.data.department is string &&
        request.resource.data.isParticipating is bool &&
        !exists(/databases/$(database)/documents/students/$(request.resource.data.studentId));

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "note", "processedAt"]);

      allow delete: if isAdmin();
    }
  }
}
